rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && request.auth.token.email == 'mdtanvirrahman2021@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function messageMember(chatId) {
      return chatId == 'global'
        || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function withinEditWindow() {
      return resource.data.createdAt != null
        && request.time < resource.data.createdAt + duration.value(10, 'm');
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if admin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.kicked == resource.data.kicked
      );
      allow delete: if admin();
    }

    match /nicknames/{nicknameKey} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/nicknames/$(nicknameKey));
      allow update: if admin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      );
      allow delete: if admin();
    }

    match /chats/{chatId} {
      allow read, write: if admin();
      allow read: if signedIn() && (
        chatId == 'global' ||
        request.auth.uid in resource.data.members
      );
      allow create: if signedIn() && (
        chatId == 'global' ||
        request.auth.uid in request.resource.data.members
      );
      allow update: if signedIn() && (
        chatId == 'global' ||
        request.auth.uid in resource.data.members
      );

      match /messages/{messageId} {
        allow read: if admin();
        allow read: if signedIn() && messageMember(chatId);

        allow create: if signedIn()
          && messageMember(chatId)
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.createdAt != null;

        // Admin can edit/delete any message at any time.
        // Normal users can edit/delete only their own message for 10 minutes.
        allow update: if admin() || (
          signedIn()
          && request.auth.uid == resource.data.sender
          && request.resource.data.sender == resource.data.sender
          && withinEditWindow()
        );

        allow delete: if admin() || (
          signedIn()
          && request.auth.uid == resource.data.sender
          && withinEditWindow()
        );
      }
    }
  }
}
