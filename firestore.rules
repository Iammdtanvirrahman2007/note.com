rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'mdtanvirrahman2021@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function messageMember(chatId) {
      return chatId == 'global'
        || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function withinEditWindow() {
      return resource.data.createdAt != null
        && request.time < resource.data.createdAt + duration.value(10, 'm');
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.kicked == resource.data.kicked
      );
      allow delete: if isAdmin();
    }

    match /nicknames/{nicknameKey} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      );
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        chatId == 'global' ||
        request.auth.uid in request.resource.data.members
      );
      allow update: if isAdmin() || (
        signedIn() && (
          chatId == 'global' ||
          request.auth.uid in resource.data.members
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && messageMember(chatId));

        allow create: if signedIn()
          && messageMember(chatId)
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.createdAt != null;

        allow update: if isAdmin() || (
          signedIn()
          && request.auth.uid == resource.data.sender
          && request.resource.data.sender == resource.data.sender
          && withinEditWindow()
        );

        allow delete: if isAdmin() || (
          signedIn()
          && request.auth.uid == resource.data.sender
          && withinEditWindow()
        );
      }
    }
  }
}
